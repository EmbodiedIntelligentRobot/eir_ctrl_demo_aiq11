# ============================================================================
# LocomotionModeSwitch.srv — 运动模式切换服务（人形AIQ11 / 四足EQR11共用）
# 各列表按cmd编号升序排列。支持表示协议用途，实际可用性受机型Profile、
# 控制器开关、策略资源和状态转换约束；不表示所有机型默认开启或已实机验收。
# QUERY(0)、RESET(253)为命令，没有对应MODE；其余同名CMD/MODE编号一致。
# 四足使用独立的 QUAD_* 编号段；具体机型及发布配置以四足工程为准。
# ⭐ 本项目（人形AIQ11）不实现四足模式：编号 25/26/27 与 101-110 在本项目一律拒绝。
#    这些常量在本文件中的存在仅为【跨分支协议一致性】；四足实现见另一分支。
# 各机型只列自身相关模式；另一机型的专用模式不列入本机型“不开放”列表。
# 完整切换规则见同目录 README.md；AMP(21/24/28/29/44)与感知行走(41)支持双向切换。
#
# ============================================================================
# 1. 人形支持列表（Sport / PRO按各自配置与资源启用）
# 编号 | 名称                    | 服务描述 / 使用边界
#   0  | QUERY                   | 查询实际模式与安全状态，不切换
#   1  | STILL                   | 停止运动，进入安全阻尼状态
#   2  | READY                   | 准备姿态
#  20  | WALK_PPO                | PPO行走；默认关闭
#  21  | WALK_AMP_OCS2           | OCS2 AMP行走
#  24  | RUN_AMP_OCS2            | OCS2 AMP跑步；实机默认关闭
#  28  | WALK_AMP_HUMANOID       | 纯人形AMP行走
#  29  | RUN_AMP_HUMANOID        | 纯人形AMP跑步
#  30  | MIMIC_A                 | 动作模仿A
#  31  | MIMIC_B                 | 动作模仿B
#  32  | MIMIC_C                 | 动作模仿C
#  33  | MIMIC_D                 | 动作模仿D
#  34  | MIMIC_E                 | 动作模仿E
#  35  | LIEDOWN_SUPINE          | 从站立躺下至仰卧
#  37  | GETUP_SUPINE            | 从仰卧起身
#  39  | FLOW_MIMIC              | Flow动作模仿；实机默认关闭
#  40  | SIT                     | 支撑坐姿；支持Motion Stream
#  41  | WALK_PERCEPTION         | 深度感知行走；实机默认关闭，仿真显式启用
#  42  | STAND_TO_SQUAT          | RL站立到下蹲，不属于WBC下蹲
#  43  | SQUAT_TO_STAND          | RL下蹲到站立，仅从STAND_TO_SQUAT进入
#  44  | JUMP_AMP_HUMANOID       | 纯人形AMP原地连续跳跃；实机待验收
# 253  | RESET                   | 进入STILL并清除安全标志
#
# ============================================================================
# 2. 人形不开放 / 已废弃列表
# 编号      | 名称 / 范围             | 状态
# 3～4      | GETUP / GETUP_INTERP    | 旧起身控制，已废弃
# 10～16    | STAND_* / SQUAT        | WBC站立与下蹲；内部测试专用，不对外开放
# 22        | WALK_QP                | WBC/QP行走；内部测试专用，不对外开放
# 23        | WALK_MPC               | MPC预留不可用；内部测试专用，不对外开放
# 36、38    | LIEDOWN_PRONE / GETUP_PRONE | 俯卧动作，预留不可用
# 254       | KIN                    | 运动学内部测试；PRO默认禁用
#
# ============================================================================
# 3. 四足对外支持列表（⭐ 本项目（人形AIQ11）不实现四足模式，编号 101-110 在本项目一律拒绝）
# 编号 | 名称                    | 服务描述
#   0  | QUERY                   | 查询当前模式
#   1  | STILL                   | 停止运动
#   2  | READY                   | 准备姿态
# 102  | QUAD_PPO                | 四足PPO行走
# 103  | QUAD_AMP_TROT           | 四足AMP对角小跑
# 104  | QUAD_AMP_BOUND          | 四足AMP跳跃步态
# 105  | QUAD_AMP_PACE           | 四足AMP同侧步态
# 106  | QUAD_AMP_MIX            | 四足AMP混合步态
# 107  | QUAD_QP                 | 四足QP行走
# 108  | QUAD_AMP_FLIP           | 四足AMP翻身
# 109  | QUAD_AMP_STAIR          | 四足AMP楼梯盲走，不含地形感知
# 110  | QUAD_PPO_WHEEL          | 轮足PPO行走，限对应机型
# 253  | RESET                   | 停止并清除安全标志
#
# ============================================================================
# 4. 四足内部测试 / 不开放列表
# 编号 | 名称                    | 状态
# 101  | QUAD_STAND              | QP站立；内部测试专用，不对外开放
#
# 旧四足编号10、20、21、22、25、26、27在本项目不再支持；10、20、21、22仅属于人形协议。
# 注：上句的"不再支持"指本项目的【功能支持】。25/26/27 的常量声明仅为跨分支协议一致性而保留，
#     与"是否提供运行支持"分属不同层面；⭐ 本项目（人形AIQ11）不实现四足模式，一律拒绝。
# 人形专用模式不在此重复列举；未列入四足支持列表不等同于四足已废弃模式。
#
# 以下为共享请求/响应定义，服务字段保持兼容；四足编号为不兼容升级。
# 常量行内SOURCES仅辅助阅读，实际转换以对应控制工程状态机为准。
# [开]/[关]表示人形实机默认开关；[禁]表示禁用；[留]表示协议预留。
# 开关开启不代表对外开放，人形WBC模式仍受第2节用途限制。

# ============================================================================
# Request: CMD — 运动模式切换命令
#
# ---- 查询 (0) ----
# 命令常量                                                        | AIQ11 SOURCES                  | AIQ11 功能                  | 四足功能
uint8 CMD_QUERY                   = 0    # QUERY                 | ANY                            | 查询当前模式                | 查询当前模式

# ---- 基础状态 (1-4) ----

uint8 CMD_STILL                   = 1    # STILL                 | ANY                            | [开] 急停                   | 急停
uint8 CMD_READY                   = 2    # READY                 | STILL, SIT, KIN, WALK_PERCEPTION | [开] 准备姿态               | 准备姿态
uint8 CMD_GETUP                   = 3    # GETUP                 | READY                          | [禁] 旧起身控制             | --
uint8 CMD_GETUP_INTERP            = 4    # GETUP_INTERP          | GETUP, SQUAT                   | [禁] 旧起身插值             | --

# ---- 站立与姿态 (10-16) ----

uint8 CMD_STAND_JOF               = 10   # 人形：内部测试专用，不对外开放；STAND_JOF             | READY*, GETUP_INTERP, JRT, SQUAT, WALK_QP, RL, KIN | [开] 关节离线站立；READY 需 getup_done | --
uint8 CMD_STAND_JRT               = 11   # 人形：内部测试专用，不对外开放；STAND_JRT             | JOF, EERT, EEOF, PLRT, PLOF, AMP | [开] 关节实时站立          | --
uint8 CMD_STAND_EERT              = 12   # 人形：内部测试专用，不对外开放；STAND_EERT            | JRT, EEOF                      | EEIK 实时站立               | --
uint8 CMD_STAND_EEOF              = 13   # 人形：内部测试专用，不对外开放；STAND_EEOF            | JOF, JRT, EERT                 | EEIK 离线站立               | --
uint8 CMD_STAND_PLRT              = 14   # 人形：内部测试专用，不对外开放；STAND_PLRT            | JRT, PLOF                      | Placo 实时站立              | --
uint8 CMD_STAND_PLOF              = 15   # 人形：内部测试专用，不对外开放；STAND_PLOF            | JOF, JRT, PLRT                 | Placo 离线站立              | --
uint8 CMD_SQUAT                   = 16   # 人形：内部测试专用，不对外开放；SQUAT                 | GETUP_INTERP, JOF              | [开] 蹲下                   | --

# ---- 人形行走 (20-22) ----

uint8 CMD_WALK_PPO                = 20   # WALK_PPO              | READY, JOF, AMP, MIMIC, FLOW | [关] PPO 行走              | --
uint8 CMD_WALK_AMP_OCS2           = 21   # WALK_AMP_OCS2         | READY, JOF, JRT, PPO, AMP, MIMIC, FLOW, LIEDOWN_SUPINE, GETUP_SUPINE, WALK_PERCEPTION, SQUAT_TO_STAND | [开] OCS2 AMP Walk | --
uint8 CMD_WALK_QP                 = 22   # 人形：内部测试专用，不对外开放；WALK_QP               | JOF                            | [开] QP 行走                | --

# ---- 行走：人形专项 (23-24) ----

uint8 CMD_WALK_MPC                = 23   # 人形：内部测试专用，不对外开放；WALK_MPC              | NONE                           | [留] MPC 行走               | --
uint8 CMD_RUN_AMP_OCS2            = 24   # RUN_AMP_OCS2          | 同CMD_WALK_AMP_OCS2来源 | [关] OCS2 AMP Run | --

# 旧四足名称：仅保留【常量声明】（名称与编号不变），用于跨分支协议一致性。
# ⛔ 本项目不承诺【运行行为兼容】，也不做 25/26/27 → 108/109/110 的翻译：
#    ⭐ 本项目（人形AIQ11）不实现四足模式，这些命令在本项目一律被拒绝。
# 四足对外编号使用 101-110（见下方"四足专项"段）。
uint8 CMD_WALK_AMP_FLIP           = 25   # 仅保留声明（本项目不支持）；四足请使用 CMD_QUAD_AMP_FLIP(108)
uint8 CMD_WALK_AMP_STAIR          = 26   # 仅保留声明（本项目不支持）；四足请使用 CMD_QUAD_AMP_STAIR(109)
uint8 CMD_WALK_PPO_WHEEL          = 27   # 仅保留声明（本项目不支持）；四足请使用 CMD_QUAD_PPO_WHEEL(110)

# ---- 行走：人形 AMP 专项 (28-29) ----

uint8 CMD_WALK_AMP_HUMANOID       = 28   # WALK_AMP_HUMANOID     | 同CMD_WALK_AMP_OCS2来源 | [开] Humanoid AMP Walk | --
uint8 CMD_RUN_AMP_HUMANOID        = 29   # RUN_AMP_HUMANOID      | 同CMD_WALK_AMP_OCS2来源 | [开] Humanoid AMP Run | --

# ---- 动作模仿系列 (30-39) ----

uint8 CMD_MIMIC_A                 = 30   # MIMIC_A               | READY, AMP_WALK                 | [开] Mimic A       | --
uint8 CMD_MIMIC_B                 = 31   # MIMIC_B               | READY, AMP_WALK                 | [开] Mimic B       | --
uint8 CMD_MIMIC_C                 = 32   # MIMIC_C               | READY, AMP_WALK                 | [开] Mimic C       | --
uint8 CMD_MIMIC_D                 = 33   # MIMIC_D               | READY, AMP_WALK                 | [开] Mimic D       | --
uint8 CMD_MIMIC_E                 = 34   # MIMIC_E               | READY, AMP_WALK                 | [开] Mimic E       | --
uint8 CMD_LIEDOWN_SUPINE          = 35   # LIEDOWN_SUPINE        | READY, AMP_WALK                 | [开] 躺下至仰卧    | --
uint8 CMD_LIEDOWN_PRONE           = 36   # LIEDOWN_PRONE         | NONE                           | [留] 俯卧动作               | --
uint8 CMD_GETUP_SUPINE            = 37   # GETUP_SUPINE          | READY                           | [开] 仰卧起身      | --
uint8 CMD_GETUP_PRONE             = 38   # GETUP_PRONE           | NONE                           | [留] 俯卧起立               | --
uint8 CMD_FLOW_MIMIC              = 39   # FLOW_MIMIC            | READY, JOF, PPO, AMP, MIMIC | [关] Flow Mimic；仿真开启 | --

# ---- 支撑姿态 (40) ----

uint8 CMD_SIT                     = 40   # SIT                   | STILL, READY                   | [开] 支撑坐姿纯位置控制；支持 Motion Stream | --
uint8 CMD_WALK_PERCEPTION         = 41   # WALK_PERCEPTION       | READY, STAND_JOF, AMP         | 感知行走 TorchScript | --
uint8 CMD_STAND_TO_SQUAT          = 42   # STAND_TO_SQUAT        | READY, STAND, AMP             | [开] 站立到蹲下 Mimic | --
uint8 CMD_SQUAT_TO_STAND          = 43   # SQUAT_TO_STAND        | STAND_TO_SQUAT                 | [开] 蹲下到站立 Mimic | --
uint8 CMD_JUMP_AMP_HUMANOID       = 44   # JUMP_AMP_HUMANOID     | READY, STAND, AMP, WALK_PERCEPTION | [开] Humanoid AMP Jump；实机待验收 | --

# ---- 四足专项 (101-110) ----
# ⭐ 本项目（人形AIQ11）不实现四足模式：以下常量仅为跨分支协议一致性保留，本项目一律拒绝。

uint8 CMD_QUAD_STAND              = 101  # QUAD_STAND            | INTERNAL                       | --                         | QP站立；内部测试专用，不对外开放
uint8 CMD_QUAD_PPO                = 102  # QUAD_PPO              | --                             | --                         | PPO行走
uint8 CMD_QUAD_AMP_TROT           = 103  # QUAD_AMP_TROT         | --                             | --                         | AMP对角小跑
uint8 CMD_QUAD_AMP_BOUND          = 104  # QUAD_AMP_BOUND        | --                             | --                         | AMP跳跃步态
uint8 CMD_QUAD_AMP_PACE           = 105  # QUAD_AMP_PACE         | --                             | --                         | AMP同侧步态
uint8 CMD_QUAD_AMP_MIX            = 106  # QUAD_AMP_MIX          | --                             | --                         | AMP混合步态
uint8 CMD_QUAD_QP                 = 107  # QUAD_QP               | --                             | --                         | QP行走
uint8 CMD_QUAD_AMP_FLIP           = 108  # QUAD_AMP_FLIP         | --                             | --                         | AMP翻身
uint8 CMD_QUAD_AMP_STAIR          = 109  # QUAD_AMP_STAIR        | --                             | --                         | AMP楼梯盲走，不含地形感知
uint8 CMD_QUAD_PPO_WHEEL          = 110  # QUAD_PPO_WHEEL        | --                             | --                         | 轮足PPO

# ---- 系统与测试 (253-254) ----

uint8 CMD_RESET                   = 253  # RESET                 | ANY                            | 急停并清安全标志            | 急停并清安全标志
uint8 CMD_KIN                     = 254  # KIN                   | READY                          | [开] 运动学测试             | --

###############################################################################
uint8 cmd

---
